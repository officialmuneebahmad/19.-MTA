# ============================================================
# Multan Tech Accessories — Production Apache Configuration
# https://multantech.store
# ============================================================

# Disable Directory Browsing
Options -Indexes -MultiViews

# Follow Symbolic Links
Options +FollowSymLinks

# Set Default Character Set
AddDefaultCharset UTF-8

# Protect Hidden Files (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect sensitive file extensions
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------
# Rewrite Engine & Canonical Redirections
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to app directory if accidentally placed inside web root
    RewriteRule ^app/ - [F,L]
    RewriteRule ^storage/ - [F,L]

    # Force HTTPS and non-www (Reverse Proxy, Cloudflare & Host Safe)
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
    RewriteRule ^(.*)$ https://multantech.store/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.multantech\.store$ [NC]
    RewriteRule ^(.*)$ https://multantech.store/$1 [L,R=301]

    # Strip Trailing Slashes (except directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Front Controller Routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ------------------------------------------------------------
# Gzip / Deflate Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------
# Browser Caching & Far-Future Headers (mod_expires)
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (stale-while-revalidate friendly)
    ExpiresByType text/html "access plus 0 seconds"

    # Assets (CSS, JS)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Static Assets Cache-Control
    <FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
