# ============================================================
# Multan Tech Accessories — Production Apache Configuration
# https://multantech.pk
# ============================================================

# Disable Directory Browsing (commented out for shared host compatibility)
# Options -Indexes -MultiViews

# Follow Symbolic Links (commented out for shared host compatibility)
# Options +FollowSymLinks

# Set Default Character Set
AddDefaultCharset UTF-8

# Protect Hidden Files (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect sensitive file extensions
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------
# Rewrite Engine & Canonical Redirections
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to app directory if accidentally placed inside web root
    RewriteRule ^app/ - [F,L]
    RewriteRule ^storage/ - [F,L]

    # ------------------------------------------------------------
    # 1. Specific Legacy 301 Redirects (Domain Migration & Old URLs)
    # Direct single-hop 301 mapping to active canonical .pk landing pages
    # ------------------------------------------------------------
    # Legacy Landing Pages (matched on both .store and .pk)
    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.(store|pk)$ [NC]
    RewriteRule ^mobile-accessories-multan\.html$ https://multantech.pk/categories/mobile-accessories [R=301,L]

    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.(store|pk)$ [NC]
    RewriteRule ^chargers-multan\.html$ https://multantech.pk/categories/power-and-charging [R=301,L]

    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.(store|pk)$ [NC]
    RewriteRule ^cables-multan\.html$ https://multantech.pk/categories/cables-and-adapters [R=301,L]

    # Legacy Discontinued Products -> Closest Active Category
    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.(store|pk)$ [NC]
    RewriteRule ^products/apple-wireless-keyboard-mouse-mini\.html$ https://multantech.pk/categories/computer-accessories [R=301,L]

    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.(store|pk)$ [NC]
    RewriteRule ^products/lenovo-lecoo-ew301-tws-wireless-earbuds\.html$ https://multantech.pk/categories/audio-and-speakers [R=301,L]

    # Legacy .html URL patterns: strip .html extension to route to modern clean URLs
    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.store$ [NC]
    RewriteRule ^(.*)\.html$ https://multantech.pk/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.pk$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)\.html$ https://multantech.pk/$1 [R=301,L]

    # ------------------------------------------------------------
    # 2. Canonical Domain Migration Catch-All: multantech.store -> multantech.pk
    # Redirect all remaining traffic from old domain (HTTP/HTTPS, www/non-www)
    # directly to https://multantech.pk preserving URI path and query.
    # ------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^(www\.)?multantech\.store$ [NC]
    RewriteRule ^(.*)$ https://multantech.pk/$1 [R=301,L]

    # ------------------------------------------------------------
    # 2. Canonical Hostname: www.multantech.pk -> https://multantech.pk
    # Strip www on new primary domain.
    # ------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.multantech\.pk$ [NC]
    RewriteRule ^(.*)$ https://multantech.pk/$1 [R=301,L]

    # ------------------------------------------------------------
    # 3. Canonical HTTPS Enforcement for multantech.pk
    # Enforces HTTPS (Reverse-Proxy, Cloudflare & StackCDN safe)
    # ------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^multantech\.pk$ [NC]
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
    RewriteRule ^(.*)$ https://multantech.pk/$1 [R=301,L]

    # Strip Trailing Slashes (except directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Front Controller Routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ------------------------------------------------------------
# Gzip / Deflate Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------
# Browser Caching & Far-Future Headers (mod_expires)
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML & Dynamic JSON APIs (stale-while-revalidate friendly, zero stale cache for APIs)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 3600 seconds"
    ExpiresByType text/xml "access plus 3600 seconds"

    # Assets (CSS, JS)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Static Assets Cache-Control & CORS
    <FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|jpeg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Sitemaps: Content-Type and 1-hour Caching
    <FilesMatch "(sitemap.*\.xml|\.xml)$">
        Header set Content-Type "application/xml; charset=UTF-8"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
